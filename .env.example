# Bird Buddies — environment config.
# Copy to .env and fill in. All COOP_* vars are optional: with Coop disabled the
# app runs exactly like the baseline (no moderation, reports dropped).

# Where this app is reachable. Coop fetches image URLs itself, so uploads must be
# reachable from the Coop server. All-local dev: leave as localhost.
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Session cookie signing secret. REQUIRED in production — generate with:
#   openssl rand -hex 32
# If unset, a random secret is generated at startup and sessions reset on restart.
SESSION_SECRET=

# Set true when served over HTTPS (behind a proxy, e.g. Fly/Railway).
SECURE_COOKIES=false
# Trust the platform's reverse proxy (defaults to the value of SECURE_COOKIES).
# TRUST_PROXY=true

# Directory for the SQLite DB and uploads. Point at a mounted volume in
# production so data survives redeploys. Defaults to the app directory.
# DATA_DIR=/data

# --- ROOST Coop integration -------------------------------------------------
COOP_ENABLED=false
COOP_API_URL=http://localhost:8080/api/v1
COOP_API_KEY=                       # Coop console -> Settings -> API Keys

# Item-type IDs you create in the Coop console (Settings -> Item Types).
COOP_PHOTO_TYPE_ID=photo            # a CONTENT type; needs an image field named below
COOP_COMMENT_TYPE_ID=comment        # a CONTENT type
COOP_USER_TYPE_ID=user              # a USER type (used as the reporter)

# Image-URL field name in your photo schema. Coop runs HMA hashing on data.images.
COOP_PHOTO_IMAGES_FIELD=images

# Webhook (Action callback) signature verification. Coop signs callbacks with
# RSA-SHA256 (coop-signature header). Paste the org's verification key to enable.
COOP_VERIFY_WEBHOOK=false
COOP_WEBHOOK_PUBLIC_KEY=
